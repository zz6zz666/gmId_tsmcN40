      "===", "===", "===", "===", "===", "===", "==="}]}], " ", "*)"}], "\n", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"yy", " ", "=", " ", 
      RowBox[{"XTRACT", "[", 
       RowBox[{
       "nch", ",", " ", "L", ",", " ", "vdsVec", ",", " ", "VSB", ",", " ", 
        "rho"}], "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"nV", " ", "=", " ", 
      RowBox[{"yy", "[", 
       RowBox[{"[", 
